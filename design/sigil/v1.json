  "typography": {
    "font_family": {
      "mono": "'Monaco', 'Menlo', 'Ubuntu Mono', monospace",
      "sans": "'-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', sans-serif",
      "serif": "'Georgia', 'Times New Roman', serif"
    },
    "font_sizes": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "32px",
      "4xl": "48px"
    },
    "font_weights": {
      "light": 300,
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "line_heights": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75,
      "loose": 2
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1)",
    "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
  },
  "motion": {
    "duration": {
      "fast": "100ms",
      "normal": "300ms",
      "slow": "500ms",
      "slowest": "1000ms"
    },
    "easing": {
      "linear": "linear",
      "ease_in": "cubic-bezier(0.4, 0, 1, 1)",
      "ease_out": "cubic-bezier(0, 0, 0.2, 1)",
      "ease_in_out": "cubic-bezier(0.4, 0, 0.2, 1)",
      "sigil_pulse": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
    }
  },
  "sigil": {
    "compliance_rules": [
      {
        "rule": "immutable_geometry",
        "description": "Sigil core geometry must not be rotated, scaled asymmetrically, or transformed",
        "weight": 1.0
      },
      {
        "rule": "color_palette_adherence",
        "description": "Only colors from the primary and neutral palettes are permitted",
        "weight": 0.8
      },
      {
        "rule": "stroke_consistency",
        "description": "All strokes must use consistent widths from the defined scale",
        "weight": 0.6
      },
      {
        "rule": "animation_boundaries",
        "description": "Motion must use only predefined duration and easing functions",
        "weight": 0.5
      },
      {
        "rule": "sovereign_geometry",
        "description": "MIII-AIM sovereign geometry: golden ratio (1.618:1) preferred for all identity artifacts; obsidian background with gold accent ratio of 8:1",
        "weight": 0.9
      },
      {
        "rule": "vault_proportion",
        "description": "Identity sigils must respect vault proportions (violet-to-gold ratio 3:1) and maintain obsidian base layer",
        "weight": 0.7
      }
    ]
  }
}
