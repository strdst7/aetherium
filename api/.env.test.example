# Copy to .env.test and fill in real values to run E2E tests against Gemini

# Gemini / Google AI Studio credentials
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Legacy alias (accepted if GEMINI_API_KEY is not set)
GOOGLE_API_KEY=your_api_key_here

# MongoDB test database
MONGODB_URI=mongodb://localhost:27017/aetherium_test

# Redis test instance
REDIS_URL=redis://localhost:6379

# Optional: set to 'true' to force real provider tests even without credentials (will fail)
FORCE_REAL_PROVIDER_TESTS=false
