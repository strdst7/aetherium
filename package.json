{
  "name": "@aetherium/root",
  "version": "1.0.0",
  "private": true,
  "description": "Aetherium — Sovereign, identity-first AI intelligence platform",
  "scripts": {
    "test:api": "cd api && npm test",
    "test:web": "cd web && npm test",
    "test:all": "npm run test:api && npm run test:web",
